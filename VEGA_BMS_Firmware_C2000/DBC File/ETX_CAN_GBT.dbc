CM_ BO_ 56 "GB/T 27930 charging data to EVCC (PDU_gbt_Data_write). Sent only while GBT_connected and contactor closed / fast charging. SOC, pack voltage, highest / lowest cell voltage, highest temperature, remaining time: see getData (0x32). Charge current limit, rated capacity: see eepromData (0x35).";
CM_ SG_ 56 GBT_Frame_ID "Frame index: 0..3 status frames, 4.. = 3 cell voltages + 1 temperature";
CM_ SG_ 56 GBT_MaxChargeVoltage "Max charging voltage = max cell charge voltage x series cells";
CM_ SG_ 56 GBT_MaxCellChargeVoltage "Max charging voltage of single cell (HIGHEST_CELL_VOLTAGE_LIMIT)";
CM_ SG_ 56 GBT_RatedVoltage "Rated (nominal) pack voltage = nominal cell voltage x series cells";
CM_ SG_ 56 GBT_BatteryType "GB/T battery type code";
CM_ SG_ 56 GBT_TotalEnergy "Total energy = rated voltage x nominal capacity";
CM_ SG_ 56 GBT_MaxPermitTemp "Max permissible temperature (HIGHEST_TEMPERATURE_LIMIT)";
CM_ SG_ 56 GBT_HighestCellID "Highest voltage cell number in series, 1-based";
CM_ SG_ 56 GBT_LowestTemp "Lowest cell temperature";
CM_ SG_ 56 GBT_LowestTempProbe "Lowest temperature probe number, 1-based, per IC";
CM_ SG_ 56 GBT_HighestTempProbe "Highest temperature probe number, 1-based, per IC";
CM_ SG_ 56 GBT_CellVoltageState "status_A: pack cell voltage state";
CM_ SG_ 56 GBT_SocState "status_A: SOC state (>70% over high, <20% below low)";
CM_ SG_ 56 GBT_ChargeOverCurrent "status_A: charging over current state";
CM_ SG_ 56 GBT_BatteryTempState "status_A: battery temperature state";
CM_ SG_ 56 GBT_InsulationState "status_B: insulation state (hard coded normal, not implemented)";
CM_ SG_ 56 GBT_SingleCellVoltages "status_B: single cell voltages state (not set in firmware)";
CM_ SG_ 56 GBT_SingleCellTemps "status_B: single cell temperatures state (not set in firmware)";
